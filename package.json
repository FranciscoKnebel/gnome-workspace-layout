{
  "name": "workspace-layout",
  "version": "0.1.0",
  "description": "GNOME Shell extension and CLI to capture and apply workspace window layouts.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "workspace-layout": "./bin/workspace-layout.js"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run clean && npm run build:shared && npm run build:extension && npm run build:cli && npm run build:schema && npm run build:metadata",
    "build:shared": "tsc -p tsconfig.shared.json",
    "build:extension": "esbuild src/extension/extension.ts --bundle --format=esm --platform=neutral --target=es2022 --external:gi://* --external:resource://* --outfile=dist/extension.js",
    "build:cli": "esbuild src/cli/workspace-layout.ts --bundle --format=esm --platform=node --target=node22 --banner:js='#!/usr/bin/env node' --outfile=bin/workspace-layout.js && chmod +x bin/workspace-layout.js",
    "build:schema": "mkdir -p dist/schema && cp schema/workspace-layout.schema.json dist/schema/workspace-layout.schema.json",
    "build:metadata": "cp extension/metadata.json dist/metadata.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "clean": "rm -rf bin dist lib coverage",
    "doctor": "node ./bin/workspace-layout.js doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:local": "npm run build && node ./bin/workspace-layout.js install",
    "lint": "eslint . && npm run format:check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.extension.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
